<https://id.acdh.oeaw.ac.at/konradbayer/kalender> a arche:Collection ;
    arche:hasContact archeId:azbl ;
    arche:hasCoverageEndDate "1964-12-31"^^xsd:date ;
    arche:hasCoverageStartDate "1953-01-01"^^xsd:date ;
    arche:hasCreator <https://orcid.org/0009-0001-4481-0967>,
        <https://orcid.org/0009-0009-6117-8244> ;
    arche:hasCurator <https://orcid.org/0000-0002-0636-4476> ;
    arche:hasDepositor archeId:azbl ;
    arche:hasDescription "Von Konrad Bayers privaten Kalendern aus dem Zeitraum 1953-1964 haben sich 11 erhalten; nur der Kalender für 1955 ist verschollen. Es handelt sich durchgängig um rote Taschenkalender (Werbegeschenke der Creditanstalt) im Format A7. Hinzu kommt ein größeres Kalenderbuch aus dem Jahr 1961 sowie ein unvollständiger Wandkalender von 1964. Aus den notierten Terminen lassen sich die Ereignisse in Bayers privatem und künstlerischen Umfeld (z.B. Vorbereitungen zu den “literarischen cabarets” der Wiener Gruppe 1958 & 1959, Dreharbeiten zu “sonne halt!” 1959) ebenso nachvollziehen wie seine internationalen Verbindungen und Reisen (u.A. zur Gruppe 47 in den Jahren 1963 & 54). Auf den letzten Seiten der meisten Kalender finden sich literarische Notizen."@de ;
    arche:hasDigitisingAgent archeId:azbl ;
    arche:hasLanguage <https://vocabs.acdh.oeaw.ac.at/iso6393/deu> ;
    arche:hasLicensor archeId:azbl ;
    arche:hasMetadataCreator <https://orcid.org/0009-0001-4481-0967>,
        <https://orcid.org/0009-0009-6117-8244> ;
    arche:hasOwner archeId:azbl ;
    arche:hasRelatedDiscipline <https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/602003>,
        <https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/605007> ;
    arche:hasRightsHolder archeId:renateganser ;
    arche:hasSpatialCoverage <https://sws.geonames.org/2761369/> ;
    arche:hasTemporalCoverage "1953-1964"@und ;
    arche:hasTitle "Konrad Bayers Taschenkalender"@de ;
    arche:hasSubject "Kalender"@de,
        "Konrad Bayer"@de,
        "Taschenkalender"@de ;
    arche:isPartOf archeId:konradbayer .

